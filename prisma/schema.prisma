generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model StockData {
  id        Int      @id @default(autoincrement())
  symbol    String
  date      DateTime
  open      Float
  high      Float
  low       Float
  volume    Int
  adjClose  Float
  close     Float    @map("price")
  timestamp DateTime @default(now())

  @@index([symbol])
  @@index([timestamp])
  @@index([date])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  comment   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Deep-research predictions written by markets-deep-research.
// Each term is { direction: 'up' | 'down' | 'neutral', confidence: number, prediction: string };
// explanations is [{ explanation: string, citationUrl: string }].
model Prediction {
  id           String   @id
  symbol       String
  timestamp    DateTime
  shortTerm    Json
  mediumTerm   Json
  longTerm     Json
  explanations Json     @default("[]")

  @@unique([symbol, timestamp])
  @@index([symbol, timestamp(sort: Desc)])
}
